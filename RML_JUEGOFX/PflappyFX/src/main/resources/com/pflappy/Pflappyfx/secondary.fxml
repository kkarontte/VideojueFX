<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.shape.Rectangle?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pflappy.Pflappyfx.SecondaryController">

    <children>

        <!-- GAME PANE OCUPA TODA LA PANTALLA -->
        <Pane fx:id="gamePane"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <children>

                <!-- PUNTUACIÓN -->
                <Label fx:id="scoreLabel"
                       layoutX="10"
                       layoutY="10"
                       text="Score: 0"
                       style="-fx-font-size:18; -fx-text-fill:white;" />

                <!-- GAME OVER (CAPA SUPERIOR) -->
                <Pane fx:id="gameOverPane"
                      visible="false"
                      AnchorPane.topAnchor="0.0"
                      AnchorPane.bottomAnchor="0.0"
                      AnchorPane.leftAnchor="0.0"
                      AnchorPane.rightAnchor="0.0">

                    <children>

                        <!-- OSCURECER FONDO -->
                        <Rectangle fill="#00000088"
                                   AnchorPane.topAnchor="0.0"
                                   AnchorPane.bottomAnchor="0.0"
                                   AnchorPane.leftAnchor="0.0"
                                   AnchorPane.rightAnchor="0.0"/>

                        <Label fx:id="gameOverLabel"
                               text="GAME OVER"
                               textFill="WHITE"
                               style="-fx-font-size:40;"
                               layoutX="200"
                               layoutY="150"/>

                        <Button fx:id="restartButton"
                                text="RESTART"
                                layoutX="250"
                                layoutY="230"
                                onAction="#onRestart"/>

                    </children>
                </Pane>

            </children>
        </Pane>

    </children>
</AnchorPane>
